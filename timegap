import re
import sys


def seconds_since_midnight(clock):
    if not re.fullmatch(r"[0-9]{2}:[0-9]{2}:[0-9]{2}", clock):
        raise ValueError("時刻はHH:MM:SS形式で入力してください")

    hours, minutes, seconds = (int(field) for field in clock.split(":"))
    return (hours * 60 + minutes) * 60 + seconds


def main():
    previous = None

    for number, line in enumerate(sys.stdin, 1):
        try:
            current = seconds_since_midnight(line.rstrip("\r\n"))
        except ValueError as error:
            print(f"{number}行目: {error}", file=sys.stderr)
            return 1

        if previous is not None:
            print(current - previous)
        previous = current

    return 0


if __name__ == "__main__":
    sys.exit(main())
